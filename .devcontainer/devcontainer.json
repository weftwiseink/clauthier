{
  "name": "clauthier",
  // NOTE: docs/worktree_development.md for details.
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "TZ": "${localEnv:TZ:America/Los_Angeles}",
      "USERNAME": "node"
    },
    "context": ".."
  },
  "remoteUser": "node",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {
      "version": "latest"
    },
    "ghcr.io/weftwiseink/devcontainer-features/lace-fundamentals:1": {},
    "ghcr.io/danzilberdan/devcontainers/opencode:0": {},
    // claude-code is expansion-provided by lace-fundamentals, but declared
    // explicitly here as the idempotent prerequisite for graphify's MCP
    // registration (installMcpServer no-ops without it).
    "ghcr.io/weftwiseink/devcontainer-features/claude-code:1": {},
    // graphify: deterministic tree-sitter code-graph CLI + MCP server.
    // Feature declares its own index mount and containerEnv; author none here.
    "ghcr.io/weftwiseink/devcontainer-features/graphify:1": {
      "version": "0.9.61",
      "installMcpServer": true,
      "installGitHook": false
    }
  },
  "customizations": {
    "lace": {
      "workspace": {
        "layout": "bare-worktree",
        "mountTarget": "/workspace/clauthier"
      }
    }
  },
  "mounts": [
    "source=${localEnv:HOME}/.local/share/opencode,target=/home/node/.local/share/opencode,type=bind"
  ],
  "containerEnv": {
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "CLAUDE_CONFIG_DIR": "${lace.mount(claude-code/config).target}"
  }
  // workspaceMount, workspaceFolder, and postCreateCommand (safe.directory) are
  // auto-generated by customizations.lace.workspace above during `lace up`.
}
